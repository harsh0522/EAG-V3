# ── REQUIRED ────────────────────────────────────────────────────────────────
# Gemini API key — Perception is pinned to Gemini. Without this the agent cannot run.
# Get it at https://aistudio.google.com (Google account, no card required)
GEMINI_API_KEY=

# Alias for GEMINI_API_KEY — some SDKs read this name. Set both to the same value.
GOOGLE_API_KEY=

# ── STRONGLY RECOMMENDED ────────────────────────────────────────────────────
# Tavily API key — primary backend for MCP web_search (DDG fallback if absent).
# Get it at https://tavily.com (1000 searches/month free, email signup)
TAVILY_API_KEY=

# ── ROUTER POOL KEYS (need at least 2) ──────────────────────────────────────
# Groq — Llama 3.3 70B, fastest free inference (~315 tok/s). No card required.
# Sign up at https://console.groq.com
GROQ_API_KEY=

# Cerebras — Llama 3.1 8B, ~1M tokens/day free tier.
# Sign up at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# NVIDIA NIM — Nemotron-nano-8b, no daily token cap. Phone verification required.
# Sign up at https://build.nvidia.com
NVIDIA_API_KEY=

# GitHub Models — Phi-4-mini, GPT-4.1, o4-mini. Uses a classic PAT (no scopes needed).
# Generate at https://github.com/marketplace/models
# NOTE: the gateway reads GITHUB_ACCESS_TOKEN (not GITHUB_TOKEN)
GITHUB_ACCESS_TOKEN=

# ── OPTIONAL FALLBACKS ───────────────────────────────────────────────────────
# OpenRouter — single key, 30+ free models, OpenAI-compatible.
# Sign up at https://openrouter.ai
# NOTE: the gateway reads OPEN_ROUTER_API_KEY (with underscore before ROUTER)
OPEN_ROUTER_API_KEY=

# Mistral La Plateforme — ~1B tokens/month free.
# Sign up at https://console.mistral.ai
MISTRAL_API_KEY=

# ── GATEWAY URL (usually no need to change) ──────────────────────────────────
LLM_GATEWAY_V3_URL=http://localhost:8101
